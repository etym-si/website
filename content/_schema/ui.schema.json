{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "strings": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][A-Za-z0-9]{0,39}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "en": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "zh-Hans": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "zh-Hant": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "required": [
          "en"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "strings"
  ],
  "additionalProperties": false
}
