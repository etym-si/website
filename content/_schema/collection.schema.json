{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "system": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "title": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "zh-Hans": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "zh-Hant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      },
      "required": [
        "en"
      ],
      "additionalProperties": false
    },
    "featured": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^([a-z][a-z0-9-]{0,31}\\/)?[^/\\s]{1,32}$"
      }
    },
    "units": {
      "minItems": 1,
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9999
          },
          "title": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "zh-Hans": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "zh-Hant": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            },
            "required": [
              "en"
            ],
            "additionalProperties": false
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "playable": {
            "type": "boolean"
          },
          "signs": {
            "minItems": 1,
            "maxItems": 60,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^([a-z][a-z0-9-]{0,31}\\/)?[^/\\s]{1,32}$"
            }
          },
          "story": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "lessons": {
            "minItems": 1,
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "learn",
                    "review",
                    "story"
                  ]
                },
                "signs": {
                  "minItems": 1,
                  "maxItems": 12,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^([a-z][a-z0-9-]{0,31}\\/)?[^/\\s]{1,32}$"
                  }
                }
              },
              "required": [
                "id",
                "kind"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "title",
          "signs"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "system",
    "title",
    "units"
  ],
  "additionalProperties": false
}
