        ],
        "additionalProperties": false
      }
    },
    "fragments": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][A-Za-z0-9]{0,31}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "en": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "zh-Hans": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "zh-Hant": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "required": [
          "en"
        ],
        "additionalProperties": false
      }
    },
    "lines": {
      "maxItems": 2000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Z][a-z]{3}$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            }
          },
          "gloss": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "zh-Hans": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "zh-Hant": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            },
            "required": [
              "en"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "text",
          "gloss"
        ],
        "additionalProperties": false
      }
    },
    "photo": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
