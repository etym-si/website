                "zh-Hans": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 800
                },
                "zh-Hant": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 800
                }
              },
              "required": [
                "en"
