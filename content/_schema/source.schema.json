{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "stage": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}\\.[a-z][a-z0-9-]{0,31}$"
    },
    "title": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "zh-Hans": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "zh-Hant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      },
      "required": [
        "en"
      ],
      "additionalProperties": false
    },
    "match": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "entries": {
      "type": "object",
