                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "zh-Hans": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "zh-Hant": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            },
            "required": [
              "en"
            ],
            "additionalProperties": false
          },
          "artifact": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "vars": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][A-Za-z0-9]{0,31}$"
            },
            "additionalProperties": {
              "type": "object",
