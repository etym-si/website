              "type": "object",
              "properties": {
                "en": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "zh-Hans": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "zh-Hant": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                }
              },
              "required": [
                "en"
              ],
              "additionalProperties": false
            },
            "text": {
              "type": "object",
              "properties": {
                "en": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 800
                },
                "zh-Hans": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 800
                },
                "zh-Hant": {
                  "type": "string",
                  "minLength": 1,
