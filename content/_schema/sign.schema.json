{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[^/\\s]+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "reviewed"
      ]
    },
    "text": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Z][a-z]{3}$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8
      }
    },
    "readings": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]{0,15}$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      }
    },
    "meaning": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "zh-Hans": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "zh-Hant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      },
      "required": [
        "en"
      ],
      "additionalProperties": false
    },
    "fact": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "zh-Hans": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "zh-Hant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        }
      },
      "required": [
        "en"
      ],
      "additionalProperties": false
    },
    "origin": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "pictogram",
            "ideogram",
            "compound-ideogram",
            "phono-semantic",
            "loan",
            "uncertain"
          ]
        },
        "parts": {
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "char": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8
              },
              "role": {
                "type": "string",
                "enum": [
                  "meaning",
                  "sound",
                  "shape"
                ]
              },
              "gloss": {
                "type": "object",
                "properties": {
                  "en": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "zh-Hans": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "zh-Hant": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  }
                },
                "required": [
                  "en"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "char",
              "role"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "sources": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "url": {
            "type": "string",
            "maxLength": 300,
            "pattern": "^https:\\/\\/[^\\s<>\"]+$"
          }
        },
        "required": [
          "title",
          "url"
        ],
        "additionalProperties": false
      }
    },
    "story": {
      "type": "object",
      "properties": {
        "topic": {
          "type": "object",
          "properties": {
            "en": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "zh-Hans": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "zh-Hant": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "required": [
            "en"
          ],
          "additionalProperties": false
        },
        "hook": {
          "type": "object",
          "properties": {
            "en": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            },
            "zh-Hans": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            },
            "zh-Hant": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            }
          },
          "required": [
            "en"
          ],
          "additionalProperties": false
        },
        "rotate": {
          "type": "object",
          "properties": {
            "en": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            },
            "zh-Hans": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            },
            "zh-Hant": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            }
          },
          "required": [
            "en"
          ],
          "additionalProperties": false
        },
        "early": {
          "type": "object",
          "properties": {
            "en": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            },
            "zh-Hans": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            },
            "zh-Hant": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            }
          },
          "required": [
            "en"
          ],
          "additionalProperties": false
        },
        "turn": {
          "type": "object",
          "properties": {
            "en": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            },
            "zh-Hans": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            },
            "zh-Hant": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            }
          },
          "required": [
            "en"
          ],
          "additionalProperties": false
        },
        "closer": {
          "type": "object",
          "properties": {
            "en": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            },
            "zh-Hans": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            },
            "zh-Hant": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            }
          },
          "required": [
            "en"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "topic",
        "hook",
        "closer"
      ],
      "additionalProperties": false
    },
    "picture": {
      "type": "object",
      "properties": {
        "rotate": {
          "type": "integer",
          "minimum": -180,
          "maximum": 180
        },
        "ambient": {
          "type": "string",
          "enum": [
            "glow",
            "flow",
            "sway",
            "flap",
            "bob"
          ]
        },
        "svg": {
          "type": "string",
          "minLength": 20,
          "maxLength": 200000
        }
      },
      "required": [
        "rotate",
        "svg"
      ],
      "additionalProperties": false
    },
    "journey": {
      "anyOf": [
        {
          "type": "string",
          "const": "default"
        },
        {
          "maxItems": 12,
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,31}$"
              },
              {
                "type": "object",
                "properties": {
                  "stage": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,31}$"
                  },
                  "form": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8
                  },
                  "variants": {
                    "minItems": 1,
                    "maxItems": 8,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,31}$"
                    }
                  }
                },
                "required": [
                  "stage"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      ]
    },
    "cards": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,31}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "exact",
              "book",
              "appears",
              "example"
            ]
          },
          "artifact": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "artifact2": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "marks": {
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "box": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  ],
                  "items": false,
                  "minItems": 4,
                  "maxItems": 4
                },
                "label": {
                  "type": "object",
                  "properties": {
                    "en": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "zh-Hans": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "zh-Hant": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    }
                  },
                  "required": [
                    "en"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "box"
              ],
              "additionalProperties": false
            }
          },
          "title": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "zh-Hans": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "zh-Hant": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            },
            "required": [
              "en"
            ],
            "additionalProperties": false
          },
          "text": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1,
                "maxLength": 800
              },
              "zh-Hans": {
                "type": "string",
                "minLength": 1,
                "maxLength": 800
              },
              "zh-Hant": {
                "type": "string",
                "minLength": 1,
                "maxLength": 800
              }
            },
            "required": [
              "en"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "kind",
          "artifact",
          "title",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "forms": {
      "maxItems": 24,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "form": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8
          },
          "variant": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "commons": {
            "type": "string",
            "pattern": "^File:[^\\n|#<>[\\]{}]{1,200}$"
          },
          "provenance": {
            "type": "object",
            "properties": {
              "period": {
                "type": "string",
                "maxLength": 20
              },
              "code": {
                "type": "string",
                "maxLength": 12
              },
              "note": {
                "type": "string",
                "maxLength": 120
              }
            },
            "required": [
              "period",
              "code",
              "note"
            ],
            "additionalProperties": false
          },
          "box": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number",
                "minimum": -10000,
                "maximum": 10000
              },
              {
                "type": "number",
                "minimum": -10000,
                "maximum": 10000
              },
              {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 20000
              },
              {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 20000
              }
            ],
            "items": false,
            "minItems": 4,
            "maxItems": 4
          },
          "paths": {
            "minItems": 1,
            "maxItems": 200,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "d": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40000,
                  "pattern": "^[MmLlHhVvCcSsQqTtAaZz0-9eE\\s,.+-]*$"
                },
                "t": {
                  "type": "string",
                  "maxLength": 400,
                  "pattern": "^\\s*((matrix|translate|scale|rotate|skewX|skewY)\\(\\s*[-+0-9.eE\\s,]*\\)\\s*)+$"
                },
                "mode": {
                  "type": "string",
                  "enum": [
                    "stroke",
                    "knockout"
                  ]
                },
                "w": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "rule": {
                  "type": "string",
                  "const": "evenodd"
                }
              },
              "required": [
                "d"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "stage",
          "form",
          "variant",
          "box",
          "paths"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "text",
    "readings",
    "meaning",
    "fact",
    "journey"
  ],
  "additionalProperties": false
}
